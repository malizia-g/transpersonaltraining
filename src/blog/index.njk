---
title: "Our Hero's Journey Blog"
layout: base.njk
description: "Articles on transpersonal psychology, holistic therapy, spiritual psychotherapy training, integrative therapy education and breathwork for anxiety."
ogtype: website
---

<section class="py-0 pb-10 md:pb-14 bg-white" lang="en">
  <div class="w-full h-64 md:h-80 overflow-hidden relative mb-8">
    <picture>
      <source srcset="{{ '/assets/images/Headers/blog-hero.webp' | url }}" type="image/webp">
      <img src="{{ '/assets/images/Headers/blog-hero.jpg' | url }}" alt="Transpersonal blog cover" class="w-full h-full object-cover object-center" loading="lazy" />
    </picture>
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 to-transparent"></div>
  </div>
  <div class="container mx-auto px-6">
    <h1 class="p4-display text-4xl md:text-5xl font-medium text-[#0F2540] mb-10 text-center">Blog</h1>
    <div class="max-w-3xl mx-auto text-center mb-12 text-neutral-warm-700 text-lg">
      <p>Insights, stories, and tools on transpersonal psychology, holistic therapy, spiritual psychotherapy training, integrative therapy education, and breathwork for anxiety.</p>
    </div>
    <!-- FILTRI (popolati JS) -->
    <form id="blog-filters" class="mb-10 flex flex-wrap gap-4 justify-center">
      <select id="filter-author" class="border px-3 py-2"><option value="">All Authors</option></select>
      <select id="filter-tag" class="border px-3 py-2"><option value="">All Tags</option></select>
      <input type="date" id="filter-date" class="border px-3 py-2" placeholder="Date" />
      <button type="reset" class="ml-2 px-4 py-2 bg-[#F3E7D4] hover:bg-neutral-warm-300">Reset</button>
    </form>
    <div class="grid grid-cols-1 md:grid-cols-1 gap-10" id="blog-articles">
      {% for post in collections.blog | reverse %}
      <article class="bg-[#FAF3E7] border border-[#E7D6BE] shadow-md p-5 sm:p-8 flex flex-col gap-4 hover:shadow-xl transition-all relative" data-author="{{ post.data.author }}" data-tags="{% if post.data.tags %}{{ post.data.tags | join('|') }}{% endif %}" data-date="{{ post.date | date('yyyy-MM-dd') }}">
        <div class="flex flex-wrap items-start gap-4 sm:flex-nowrap">
          {% if post.data.image %}
          <picture>
            {% if '.jpg' in post.data.image %}<source srcset="{{ post.data.image | blogImage | replace('.jpg', '.webp') | url }}" type="image/webp">{% endif %}
            <img src="{{ post.data.image | blogImage | url }}" alt="{{ post.data.imageAlt or post.data.title }}" class="w-20 h-20 sm:w-32 sm:h-32 object-cover flex-shrink-0" loading="lazy" />
          </picture>
          {% endif %}
          <div class="min-w-0 flex-1 sm:flex sm:flex-col">
            <h2 class="text-xl sm:text-2xl font-serif font-bold text-indigo-deep-900 mb-2 leading-tight">{{ post.data.title }}</h2>
            <div class="hidden sm:block text-xs sm:text-sm text-neutral-warm-600 mb-2 leading-relaxed">
              <span>By {% if post.data.authorUrl %}<a href="{{ post.data.authorUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-science-blue-700 underline underline-offset-2 transition-colors">{{ post.data.author }}</a>{% else %}{{ post.data.author }}{% endif %}</span> &middot; <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("dd MMM yyyy") }}</time>
            </div>
            <div class="hidden sm:block text-xs text-neutral-warm-500 leading-relaxed">{% if post.data.tags %}{{ post.data.tags | join(', ') }}{% endif %}</div>
            {% if post.data.sourceUrl %}<div class="hidden sm:flex items-center gap-1 mt-1 text-xs text-[#B65E3F]"><i data-lucide="external-link" class="w-3 h-3"></i><span>Via <a href="{{ post.data.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[#7A5E29] transition-colors">{{ post.data.source if post.data.source else post.data.sourceUrl }}</a></span></div>{% endif %}
            <a href="{{ post.url | url }}" class="hidden sm:inline-flex mt-3 text-[#B65E3F] hover:underline font-medium text-left">Read more →</a>
          </div>
          <div class="basis-full sm:hidden">
            <div class="text-xs text-neutral-warm-600 mb-2 leading-relaxed">
              <span>By {% if post.data.authorUrl %}<a href="{{ post.data.authorUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-science-blue-700 underline underline-offset-2 transition-colors">{{ post.data.author }}</a>{% else %}{{ post.data.author }}{% endif %}</span> &middot; <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("dd MMM yyyy") }}</time>
            </div>
            <div class="text-xs text-neutral-warm-500 leading-relaxed">{% if post.data.tags %}{{ post.data.tags | join(', ') }}{% endif %}</div>
            {% if post.data.sourceUrl %}<div class="flex items-center gap-1 mt-1 text-xs text-[#B65E3F]"><i data-lucide="external-link" class="w-3 h-3"></i><span>Via <a href="{{ post.data.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[#7A5E29] transition-colors">{{ post.data.source if post.data.source else post.data.sourceUrl }}</a></span></div>{% endif %}
          </div>
        </div>
        <p class="text-neutral-warm-700">{{ post.data.description }}</p>
        <a href="{{ post.url | url }}" class="sm:hidden mt-2 text-[#B65E3F] hover:underline font-medium text-left">Read more →</a>
      </article>
      {% else %}
      <p class="col-span-2 text-center text-neutral-warm-500">No articles published yet.</p>
      {% endfor %}
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // FILTRI: popola filtri ma NON applica filtro iniziale
        const form = document.getElementById('blog-filters');
        const cards = Array.from(document.querySelectorAll('#blog-articles article'));
        // Popola filtri
        const authors = new Set();
        const tags = new Set();
        const cardTags = card => (card.dataset.tags || '').split('|').map(t => t.trim()).filter(Boolean);
        cards.forEach(card => {
          const author = (card.dataset.author || '').trim();
          if (author) authors.add(author);
          cardTags(card).forEach(tag => tags.add(tag));
        });
        const authorSelect = document.getElementById('filter-author');
        authors.forEach(author => {
          const opt = document.createElement('option');
          opt.value = author; opt.textContent = author;
          authorSelect.appendChild(opt);
        });
        const tagSelect = document.getElementById('filter-tag');
        tags.forEach(tag => {
          const opt = document.createElement('option');
          opt.value = tag; opt.textContent = tag;
          tagSelect.appendChild(opt);
        });
        // Filtra card SOLO dopo interazione utente
        form.addEventListener('input', function() {
          const author = authorSelect.value;
          const tag = tagSelect.value;
          const date = document.getElementById('filter-date').value;
          cards.forEach(function(card) {
            let show = true;
            const cardAuthor = (card.dataset.author || '').trim();
            const cardDate = card.dataset.date;
            if (author && cardAuthor !== author) show = false;
            if (tag && !cardTags(card).includes(tag)) show = false;
            if (date && (!cardDate || !cardDate.startsWith(date))) show = false;
            card.style.display = show ? '' : 'none';
          });
        });
        form.addEventListener('reset', function() {
          setTimeout(() => form.dispatchEvent(new Event('input')), 10);
        });
      });
    </script>
    </div>
  </div>
</section>
