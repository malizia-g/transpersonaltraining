---
title: "Our Hero's Journey Blog"
layout: base.njk
description: "Articles on transpersonal psychology, holistic therapy, spiritual psychotherapy training, integrative therapy education and breathwork for anxiety."
ogtype: website
---

<header class="hero-clear relative h-[50vh] min-h-[400px] flex items-center justify-center text-[color:var(--c-on-dark-1)] bg-[color:var(--c-deep)] overflow-hidden" lang="en">
  <div class="absolute inset-0 z-0">
    <picture>
      <source srcset="{{ '/assets/images/Headers/blog-hero.webp' | url }}" type="image/webp">
      <img src="{{ '/assets/images/Headers/blog-hero.jpg' | url }}" alt="Wildflowers by the path outside the seminar house" class="w-full h-full object-cover object-center">
    </picture>
    <div class="absolute inset-0 hero-clear-scrim"></div>
  </div>
  <div class="container mx-auto px-6 relative z-10 text-center pt-20">
    <div class="max-w-4xl mx-auto">
      <p class="p4-kicker text-[color:var(--c-acc)] mb-6 flex items-center justify-center gap-4">
        <span class="p4-hairline"></span>
        Our hero's journey
        <span class="p4-hairline"></span>
      </p>
      <h1 class="p4-display text-4xl md:text-6xl font-medium mb-6 leading-tight text-[color:var(--c-paper-hi)]">
        Blog
      </h1>
      <p class="text-xl md:text-2xl text-[color:var(--c-on-dark-3)] font-light leading-relaxed max-w-3xl mx-auto">
        Insights, stories, and tools on transpersonal psychology, holistic therapy, spiritual psychotherapy training, integrative therapy education, and breathwork for anxiety.
      </p>
    </div>
  </div>
</header>

<!-- Breadcrumb -->
<div class="bg-[color:var(--c-paper-card)] border-b border-[color:var(--c-line)]">
  <div class="container mx-auto px-6 py-4">
    <div class="flex items-center gap-2 text-sm text-[color:var(--c-body-dim)]">
      <a href="{{ '/' | url }}" class="hover:text-[color:var(--c-link)] transition-colors">Home</a>
      <i data-lucide="chevron-right" class="w-4 h-4"></i>
      <span class="text-[color:var(--c-heading)] font-medium">Blog</span>
    </div>
  </div>
</div>

<section class="py-12 md:py-16 bg-[color:var(--c-paper-hi)]" lang="en">
  <div class="container mx-auto px-6">
    <!-- FILTRI (popolati JS) -->
    <form id="blog-filters" class="mb-10 flex flex-wrap gap-4 justify-center">
      <select id="filter-author" class="border px-3 py-2"><option value="">All Authors</option></select>
      <select id="filter-tag" class="border px-3 py-2"><option value="">All Tags</option></select>
      <input type="date" id="filter-date" class="border px-3 py-2" placeholder="Date" />
      <button type="reset" class="ml-2 px-4 py-2 bg-[color:var(--c-paper-2)] hover:bg-[color:var(--c-line)]">Reset</button>
    </form>
    <div class="grid grid-cols-1 md:grid-cols-1 gap-10" id="blog-articles">
      {% for post in collections.blog | reverse %}
      <article class="bg-[color:var(--c-paper)] border border-[color:var(--c-line)] shadow-md p-5 sm:p-8 flex flex-col gap-4 hover:shadow-xl transition-all relative" data-author="{{ post.data.author }}" data-tags="{% if post.data.tags %}{{ post.data.tags | join('|') }}{% endif %}" data-date="{{ post.date | date('yyyy-MM-dd') }}">
        <div class="flex flex-wrap items-start gap-4 sm:flex-nowrap">
          {% if post.data.image %}
          <picture>
            {% if '.jpg' in post.data.image %}<source srcset="{{ post.data.image | blogImage | replace('.jpg', '.webp') | url }}" type="image/webp">{% endif %}
            <img src="{{ post.data.image | blogImage | url }}" alt="{{ post.data.imageAlt or post.data.title }}" class="w-20 h-20 sm:w-32 sm:h-32 object-cover flex-shrink-0" loading="lazy" />
          </picture>
          {% endif %}
          <div class="min-w-0 flex-1 sm:flex sm:flex-col">
            <h2 class="text-xl sm:text-2xl font-serif font-bold text-[color:var(--c-heading)] mb-2 leading-tight">{{ post.data.title }}</h2>
            <div class="hidden sm:block text-xs sm:text-sm text-[color:var(--c-body-dim)] mb-2 leading-relaxed">
              <span>By {% if post.data.authorUrl %}<a href="{{ post.data.authorUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--c-link-hover)] underline underline-offset-2 transition-colors">{{ post.data.author }}</a>{% else %}{{ post.data.author }}{% endif %}</span> &middot; <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("dd MMM yyyy") }}</time>
            </div>
            <div class="hidden sm:block text-xs text-[color:var(--c-body-dim)] leading-relaxed">{% if post.data.tags %}{{ post.data.tags | join(', ') }}{% endif %}</div>
            {% if post.data.sourceUrl %}<div class="hidden sm:flex items-center gap-1 mt-1 text-xs text-[color:var(--c-sec)]"><i data-lucide="external-link" class="w-3 h-3"></i><span>Via <a href="{{ post.data.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[color:var(--c-sec-dark)] transition-colors">{{ post.data.source if post.data.source else post.data.sourceUrl }}</a></span></div>{% endif %}
            <a href="{{ post.url | url }}" class="hidden sm:inline-flex mt-3 text-[color:var(--c-sec)] hover:underline font-medium text-left">Read more →</a>
          </div>
          <div class="basis-full sm:hidden">
            <div class="text-xs text-[color:var(--c-body-dim)] mb-2 leading-relaxed">
              <span>By {% if post.data.authorUrl %}<a href="{{ post.data.authorUrl }}" target="_blank" rel="noopener noreferrer" class="hover:text-[color:var(--c-link-hover)] underline underline-offset-2 transition-colors">{{ post.data.author }}</a>{% else %}{{ post.data.author }}{% endif %}</span> &middot; <time datetime="{{ post.date | date('yyyy-MM-dd') }}">{{ post.date | date("dd MMM yyyy") }}</time>
            </div>
            <div class="text-xs text-[color:var(--c-body-dim)] leading-relaxed">{% if post.data.tags %}{{ post.data.tags | join(', ') }}{% endif %}</div>
            {% if post.data.sourceUrl %}<div class="flex items-center gap-1 mt-1 text-xs text-[color:var(--c-sec)]"><i data-lucide="external-link" class="w-3 h-3"></i><span>Via <a href="{{ post.data.sourceUrl }}" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[color:var(--c-sec-dark)] transition-colors">{{ post.data.source if post.data.source else post.data.sourceUrl }}</a></span></div>{% endif %}
          </div>
        </div>
        <p class="text-[color:var(--c-body)]">{{ post.data.description }}</p>
        <a href="{{ post.url | url }}" class="sm:hidden mt-2 text-[color:var(--c-sec)] hover:underline font-medium text-left">Read more →</a>
      </article>
      {% else %}
      <p class="col-span-2 text-center text-[color:var(--c-body-dim)]">No articles published yet.</p>
      {% endfor %}
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        // FILTRI: popola filtri ma NON applica filtro iniziale
        const form = document.getElementById('blog-filters');
        const cards = Array.from(document.querySelectorAll('#blog-articles article'));
        // Popola filtri
        const authors = new Set();
        const tags = new Set();
        const cardTags = card => (card.dataset.tags || '').split('|').map(t => t.trim()).filter(Boolean);
        cards.forEach(card => {
          const author = (card.dataset.author || '').trim();
          if (author) authors.add(author);
          cardTags(card).forEach(tag => tags.add(tag));
        });
        const authorSelect = document.getElementById('filter-author');
        authors.forEach(author => {
          const opt = document.createElement('option');
          opt.value = author; opt.textContent = author;
          authorSelect.appendChild(opt);
        });
        const tagSelect = document.getElementById('filter-tag');
        tags.forEach(tag => {
          const opt = document.createElement('option');
          opt.value = tag; opt.textContent = tag;
          tagSelect.appendChild(opt);
        });
        // Filtra card SOLO dopo interazione utente
        form.addEventListener('input', function() {
          const author = authorSelect.value;
          const tag = tagSelect.value;
          const date = document.getElementById('filter-date').value;
          cards.forEach(function(card) {
            let show = true;
            const cardAuthor = (card.dataset.author || '').trim();
            const cardDate = card.dataset.date;
            if (author && cardAuthor !== author) show = false;
            if (tag && !cardTags(card).includes(tag)) show = false;
            if (date && (!cardDate || !cardDate.startsWith(date))) show = false;
            card.style.display = show ? '' : 'none';
          });
        });
        form.addEventListener('reset', function() {
          setTimeout(() => form.dispatchEvent(new Event('input')), 10);
        });
      });
    </script>
    </div>
  </div>
</section>
