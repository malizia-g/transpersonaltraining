{% set heroImage = '/assets/images/Headers/hero-teachers-faculty' %}
{% set heroAlt = 'The seminar house at Todtmoos among the Black Forest trees' %}
{% set kicker = 'Core Teacher' if teacher.section == 'core' else ('Guest Teacher' if teacher.section == 'guest' else 'Has taught with us') %}
{% set heading = teacher.name %}
{% set subheading = [teacher.role if teacher.section == 'core' else '', teacher.location] | compact | join(' &middot; ') %}
{% include "detail-hero.njk" %}
{% set crumb = teacher.name %}
{% include "detail-breadcrumb.njk" %}

{% set mySeminars = teacher.id | teacherSeminars(scheduleEvents) %}
{% set myTopics = teacher.id | teacherTopics(lectureEvents) %}

<section class="py-16 md:py-20 bg-[color:var(--c-paper-hi)]">
    <div class="container mx-auto px-6">
        <div class="max-w-6xl mx-auto grid lg:grid-cols-[minmax(0,320px)_1fr] gap-10 lg:gap-14 items-start">

            <aside class="lg:sticky lg:top-28">
                <picture>
                    <source srcset="{{ teacher.image | replace('.jpg', '.webp') | url }}" type="image/webp">
                    <img src="{{ teacher.image | url }}" alt="Portrait of {{ teacher.name }}" class="w-full aspect-[4/5] object-cover shadow-md"{% if teacher.imagePosition %} style="object-position: {{ teacher.imagePosition }};"{% endif %}>
                </picture>
                <dl class="mt-6 space-y-4 text-sm">
                    {% if teacher.credentials %}
                    <div>
                        <dt class="p4-kicker text-[color:var(--c-sec)] mb-1">Credentials</dt>
                        <dd class="text-[color:var(--c-body)]">{{ teacher.credentials }}</dd>
                    </div>
                    {% endif %}
                    {% if teacher.location %}
                    <div>
                        <dt class="p4-kicker text-[color:var(--c-sec)] mb-1">Based in</dt>
                        <dd class="text-[color:var(--c-body)]">{{ teacher.location }}</dd>
                    </div>
                    {% endif %}
                    {% if teacher.website %}
                    <div>
                        <dt class="p4-kicker text-[color:var(--c-sec)] mb-1">Website</dt>
                        <dd><a href="{{ teacher.website }}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-[color:var(--c-link)] hover:text-[color:var(--c-link-hover)] underline underline-offset-4 break-all">
                            <i data-lucide="globe" class="w-4 h-4 flex-shrink-0"></i>{{ teacher.website | replace('https://', '') | replace('http://', '') | replace('www.', '') }}</a></dd>
                    </div>
                    {% endif %}
                </dl>
            </aside>

            <div class="min-w-0">
                <h2 class="p4-display text-3xl md:text-4xl font-medium text-[color:var(--c-heading)] mb-5">About {{ teacher.name }}</h2>
                <div class="detail-prose">
                    {% if teacher.bio %}{{ teacher.bio | markdown | safe }}{% else %}{{ teacher.id | getBio | safe }}{% endif %}
                </div>

                {% if teacher.credentials_detail %}
                <h2 class="p4-display text-2xl md:text-3xl font-medium text-[color:var(--c-heading)] mt-12 mb-4">Training &amp; credentials</h2>
                <div class="detail-prose">{{ teacher.credentials_detail | markdown | safe }}</div>
                {% endif %}

                {% if teacher.experience %}
                <h2 class="p4-display text-2xl md:text-3xl font-medium text-[color:var(--c-heading)] mt-12 mb-4">Professional practice</h2>
                <div class="detail-prose">{{ teacher.experience | markdown | safe }}</div>
                {% endif %}

                {% if teacher.publications %}
                <h2 class="p4-display text-2xl md:text-3xl font-medium text-[color:var(--c-heading)] mt-12 mb-4">Selected publications</h2>
                <div class="detail-prose">{{ teacher.publications | markdown | safe }}</div>
                {% endif %}

                {% if mySeminars.length %}
                <h2 class="p4-display text-2xl md:text-3xl font-medium text-[color:var(--c-heading)] mt-14 mb-2">Seminars with {{ teacher.name }}</h2>
                <p class="text-[color:var(--c-body-dim)] mb-5">{{ mySeminars.length }} residential seminar{{ 's' if mySeminars.length != 1 }} and Holotropic Breathwork intensive{{ 's' if mySeminars.length != 1 }} in the Transpersonal Training programme.</p>
                <ul class="divide-y divide-[color:var(--c-line)] border-y border-[color:var(--c-line)]">
                    {% for s in mySeminars %}
                    <li>
                        <a href="{{ s.url | url }}" class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-3 hover:bg-[color:var(--c-paper)] transition-colors">
                            <span class="text-sm text-[color:var(--c-body-dim)] sm:w-48 flex-shrink-0">{{ s.dateText }}</span>
                            <span class="flex-1">
                                <span class="font-medium text-[color:var(--c-heading)] group-hover:text-[color:var(--c-link)]">{{ s.cleanTitle }}</span>
                                {% if s.placeName or s.city %}<span class="block text-sm text-[color:var(--c-body-dim)]">{{ [s.placeName, s.city] | compact | join(' · ') }}</span>{% endif %}
                            </span>
                            {% if not s.isPast and s.range %}<span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 border border-[color:var(--c-acc-40)] text-[color:var(--c-sec)] self-start">Upcoming</span>{% endif %}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}

                {% if myTopics.length %}
                <h2 class="p4-display text-2xl md:text-3xl font-medium text-[color:var(--c-heading)] mt-14 mb-2">Online lectures by {{ teacher.name }}</h2>
                <p class="text-[color:var(--c-body-dim)] mb-5">Topics {{ teacher.name }} teaches in the online lecture programme.</p>
                <ul class="grid sm:grid-cols-2 gap-3">
                    {% for t in myTopics %}
                    <li>
                        <a href="{{ t.url | url }}" class="group block h-full p-4 bg-[color:var(--c-paper-card)] border border-[color:var(--c-line)] hover:border-[color:var(--c-acc)] transition-colors">
                            <span class="block font-medium text-[color:var(--c-heading)] group-hover:text-[color:var(--c-link)]">{{ t.title }}</span>
                            <span class="block text-xs text-[color:var(--c-body-dim)] mt-1">{{ t.sessions.length }} session{{ 's' if t.sessions.length != 1 }}</span>
                        </a>
                    </li>
                    {% endfor %}
                </ul>
                {% endif %}

                <div class="mt-14 pt-8 border-t border-[color:var(--c-line)] flex flex-wrap gap-4">
                    <a href="{{ '/teachers/' | url }}" class="inline-flex items-center gap-2 text-[color:var(--c-sec)] hover:text-[color:var(--c-sec-dark)] font-medium">
                        <i data-lucide="arrow-left" class="w-4 h-4"></i> All teachers
                    </a>
                    <a href="{{ '/training-overview/' | url }}" class="inline-flex items-center gap-2 text-[color:var(--c-sec)] hover:text-[color:var(--c-sec-dark)] font-medium">
                        About the training <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
