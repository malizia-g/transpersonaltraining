{% set t = i18n[lang] %}
{% set homeUrl = '/' | localeUrl(lang) %}
{% set contactHref = '#contact' if page.url == homeUrl else ((homeUrl | url) ~ '#contact') %}
{# The language switcher goes to this page in the other language when it
   exists, and to that language's home page when it doesn't. Clicking it also
   records the choice, so the automatic redirect in base.njk never overrides a
   reader who has picked a language by hand. #}
{% set otherLang = 'en' if lang == 'ru' else 'ru' %}
{% set altKey = translationOf or page.url %}
{% set alts = collections.translations[altKey] %}
{% set switchHref = (alts[otherLang] if (alts and alts[otherLang]) else ('/' | localeUrl(otherLang))) | url %}
{% set switchClick = "try{localStorage.setItem('lang','" ~ otherLang ~ "')}catch(e){}" %}
<nav id="navbar" class="fixed w-full z-50 transition-all duration-300 py-6 bg-transparent text-[color:var(--c-on-dark-2)]">
    <div class="container mx-auto px-6 flex justify-between items-center relative z-10">
        <!-- Logo (Desktop Only) -->
        <a href="{{ homeUrl | url }}" class="hidden md:flex items-center gap-2 hover:opacity-80 transition-opacity">
            <div class="w-10 h-10 flex items-center justify-center bg-[color:var(--c-acc)] rounded-full transition-transform duration-300 group hover:rotate-180 shrink-0">
                <img src="{{ '/assets/images/Graphics/logo.svg' | url }}" alt="Logo" class="w-8 h-8 transition-transform duration-500 group-hover:rotate-180" style="display:block;" />
            </div>
            <span class="flex flex-col justify-center h-10 leading-none font-serif font-bold text-[color:var(--c-on-dark-1)]">
                <span class="text-[0.7rem] tracking-widest leading-none">EastWest</span>
                <span class="text-[1.35rem] tracking-wide leading-none mt-0.5">Transpersonal Training</span>
            </span>
        </a>

        <!-- Logo (Mobile Only) -->
        <a href="{{ homeUrl | url }}" class="flex md:hidden items-center gap-2 hover:opacity-80 transition-opacity">
            <div class="w-8 h-8 flex items-center justify-center bg-[color:var(--c-acc)] rounded-full transition-transform duration-300 group hover:rotate-180 shrink-0">
                <img src="{{ '/assets/images/Graphics/logo.svg' | url }}" alt="Logo" class="w-6 h-6 transition-transform duration-500 group-hover:rotate-180" style="display:block;" />
            </div>
            <span class="flex flex-col justify-center h-8 leading-none font-serif font-bold text-[color:var(--c-on-dark-1)]">
                <span class="text-[0.6rem] tracking-widest leading-none">EastWest</span>
                <span class="text-[1.05rem] tracking-wide leading-none mt-0.5">Transpersonal Training</span>
            </span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-8">
            {% for group in [navigation.training, navigation.resources] %}
            <div class="dropdown">
                <button type="button" class="nav-link text-sm font-medium hover:text-[color:var(--c-acc)] transition-colors flex items-center gap-1 bg-transparent border-none cursor-pointer">
                    {{ group.label[lang] }} <i data-lucide="chevron-down" class="w-4 h-4"></i>
                </button>
                <div class="dropdown-menu">
                    {% for item in group.items %}
                    <a href="{{ item.url if item.external else (item.url | localeUrl(lang) | url) }}"{% if item.external %} target="_blank" rel="noopener"{% endif %} class="text-sm">
                        <i data-lucide="{{ item.icon }}" class="w-4 h-4 submenu-icon"></i>
                        <span>{{ item.label[lang] }}</span>
                        {% if not item.external and not (item.url | hasTranslation(lang)) %}<span class="ml-auto text-[10px] tracking-wider opacity-60" title="{{ t.englishOnly }}">EN</span>{% endif %}
                    </a>
                    {% endfor %}
                </div>
            </div>
            {% endfor %}

            <a href="{{ navigation.blog.url | localeUrl(lang) | url }}" class="nav-link text-sm font-medium hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.blog.label[lang] }}</a>

            <a href="{{ switchHref }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}" onclick="{{ switchClick }}" title="{{ t.switchTo }}" class="nav-link text-xs font-semibold tracking-widest hover:text-[color:var(--c-acc)] transition-colors border border-[color:var(--c-acc-40)] px-2 py-1">{{ i18n[otherLang].short }}</a>

            <a href="{{ contactHref }}" class="bg-[color:var(--c-acc)] hover:bg-[color:var(--c-acc-dark)] text-[color:var(--c-deep)] px-4 py-1.5 text-xs lg:px-6 lg:py-2 lg:text-sm font-medium tracking-wide transition-colors shadow-md whitespace-nowrap">{{ t.requestDemo }}</a>
        </div>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-btn" class="md:hidden text-[color:var(--c-on-dark-1)] focus:outline-none">
            <i data-lucide="menu" class="w-7 h-7"></i>
        </button>
    </div>

    <!-- Mobile Menu Dropdown -->
    <div id="mobile-menu" class="hidden md:hidden absolute top-full left-0 w-full shadow-xl py-6 px-6 flex-col gap-4 z-20 border-t">
        {% for group in [navigation.training, navigation.resources] %}
        <span class="text-[color:var(--c-on-dark-2)] py-2 border-b block font-semibold">{{ group.label[lang] }}</span>
        {% for item in group.items %}
        <a href="{{ item.url if item.external else (item.url | localeUrl(lang) | url) }}"{% if item.external %} target="_blank" rel="noopener"{% endif %} class="text-[color:var(--c-on-dark-2)] py-2 pl-4 border-b flex items-center gap-2 transition-colors text-sm">
            <i data-lucide="{{ item.icon }}" class="w-4 h-4 submenu-icon"></i>
            <span>{{ item.label[lang] }}</span>
            {% if not item.external and not (item.url | hasTranslation(lang)) %}<span class="ml-auto text-[10px] tracking-wider opacity-60" title="{{ t.englishOnly }}">EN</span>{% endif %}
        </a>
        {% endfor %}
        {% endfor %}
        <a href="{{ navigation.blog.url | localeUrl(lang) | url }}" class="text-[color:var(--c-on-dark-2)] py-2 border-b block transition-colors">{{ navigation.blog.label[lang] }}</a>
        <a href="{{ switchHref }}" hreflang="{{ otherLang }}" lang="{{ otherLang }}" onclick="{{ switchClick }}" class="text-[color:var(--c-on-dark-2)] py-2 border-b flex items-center gap-2 transition-colors text-sm">
            <i data-lucide="languages" class="w-4 h-4 submenu-icon"></i>
            <span>{{ t.switchTo }}</span>
        </a>
        <a href="{{ contactHref }}" class="bg-[color:var(--c-acc)] text-[color:var(--c-deep)] px-6 py-3 w-full mt-4 font-bold text-center block">{{ t.requestDemo }}</a>
    </div>
</nav>
