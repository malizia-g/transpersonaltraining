{% set t = i18n[lang] %}
{% set f = t.footer %}
{# Link labels come from the menu data (navigation.labels), so a page is
   called the same thing in the menu and here, in every language. #}
{% set homeUrl = '/' | localeUrl(lang) %}
{% set contactHref = '#contact' if page.url == homeUrl else ((homeUrl | url) ~ '#contact') %}
<footer class="bg-[color:var(--c-deepest)] text-[color:var(--c-on-dark-3)] py-16">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 border-b border-white/10 pb-12 mb-12">
            <!-- About Column -->
            <div>
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-10 h-10 flex items-center justify-center bg-[color:var(--c-acc)] rounded-full shrink-0">
                        <img src="{{ '/assets/images/Graphics/logo.svg' | url }}" alt="Logo" class="w-8 h-8" style="display:block;" />
                    </div>
                    <h3 class="p4-display text-[color:var(--c-on-dark-1)] font-semibold leading-tight">
                        <span class="block text-sm tracking-widest font-normal mt-1">EastWest</span>
                        <span class="block text-xl tracking-wide">Transpersonal Training</span>
                    </h3>
                </div>
                <p class="text-sm leading-relaxed text-[color:var(--c-on-dark-4)]">
                    {{ f.tagline }}
                </p>
                <p class="text-xs leading-relaxed text-[color:var(--c-on-dark-5)] mt-4">
                    Eastwest Transpersonal Training School
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="p4-kicker text-[color:var(--c-acc)] mb-5">{{ f.training }}</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ '/training-overview/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/training-overview/'][lang] }}</a></li>
                    <li><a href="{{ '/curriculum/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/curriculum/'][lang] }}</a></li>
                    <li><a href="{{ '/schedule/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/schedule/'][lang] }}</a></li>
                    <li><a href="{{ '/lectures-schedule/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/lectures-schedule/'][lang] }}</a></li>
                    <li><a href="{{ '/teachers/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/teachers/'][lang] }}</a></li>
                    <li><a href="{{ '/blog/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/blog/'][lang] }}</a></li>
                </ul>
            </div>

            <!-- Resources -->
            <div>
                <h4 class="p4-kicker text-[color:var(--c-acc)] mb-5">{{ f.resources }}</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ '/techniques/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/techniques/'][lang] }}</a></li>
                    <li><a href="{{ '/venues/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/venues/'][lang] }}</a></li>
                    <li><a href="{{ '/what-is-transpersonal-psychology/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/what-is-transpersonal-psychology/'][lang] }}</a></li>
                    <li><a href="{{ '/become-a-practice-client/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/become-a-practice-client/'][lang] }}</a></li>
                    <li><a href="{{ '/resources/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/resources/'][lang] }}</a></li>
                    <li><a href="{{ '/collaborations/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['/collaborations/'][lang] }}</a></li>
                    <li><a href="https://student.transpersonal-training.com/" target="_blank" rel="noopener" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['https://student.transpersonal-training.com/'][lang] }}</a></li>
                    <li><a href="https://old.transpersonal-training.com/" target="_blank" rel="noopener" class="hover:text-[color:var(--c-acc)] transition-colors">{{ navigation.labels['https://old.transpersonal-training.com/'][lang] }}</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div>
                <h4 class="p4-kicker text-[color:var(--c-acc)] mb-5">{{ f.connect }}</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ contactHref }}" class="hover:text-[color:var(--c-acc)] transition-colors">{{ f.contactUs }}</a></li>
                    <li><a href="mailto:west-office@transpersonal-training.com" class="hover:text-[color:var(--c-acc)] transition-colors">{{ f.westOffice }} &middot; west-office@transpersonal-training.com</a></li>
                    <li><a href="mailto:east-office@transpersonal-training.com" class="hover:text-[color:var(--c-acc)] transition-colors">{{ f.eastOffice }} &middot; east-office@transpersonal-training.com</a></li>
                    <li><a href="tel:+4917638034517" class="hover:text-[color:var(--c-acc)] transition-colors">{{ f.westOffice }} &middot; +49 176 38034517</a></li>
                    <li><a href="tel:+37379024199" class="hover:text-[color:var(--c-acc)] transition-colors">{{ f.eastOffice }} &middot; +373 79024199</a></li>
                    <li><a href="https://www.facebook.com/EastwestTranspersonalTrainingSchool/" target="_blank" rel="noopener" class="hover:text-[color:var(--c-acc)] transition-colors inline-flex items-center gap-1.5"><i data-lucide="facebook" class="w-4 h-4"></i>Facebook</a></li>
                    <li><button type="button" onclick="document.getElementById('privacy-modal').showModal()" class="hover:text-[color:var(--c-acc)] transition-colors text-left bg-transparent border-none p-0 cursor-pointer font-inherit">{{ f.privacy }}</button></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="flex flex-col md:flex-row justify-between items-center text-xs text-[color:var(--c-on-dark-5)]">
            <p>&copy; 2026 transpersonal-training.com — {{ f.copyright }}</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <button type="button" onclick="document.getElementById('privacy-modal').showModal()" class="hover:text-[color:var(--c-acc)] bg-transparent border-none p-0 cursor-pointer font-inherit">{{ f.privacyShort }}</button>
                <a href="{{ '/legal-notice/' | localeUrl(lang) | url }}" class="hover:text-[color:var(--c-acc)]">{{ f.legalNotice }}</a>
            </div>
        </div>
    </div>
</footer>

<!-- Privacy Policy Modal -->
<dialog id="privacy-modal" class="max-w-2xl w-[92vw] p-0 backdrop:bg-[color:var(--c-deepest-70)] shadow-2xl">
    <div class="bg-[color:var(--c-paper-card)] max-h-[85vh] overflow-y-auto">
        <div class="sticky top-0 bg-[color:var(--c-deep)] text-[color:var(--c-paper-hi)] px-6 py-5 flex items-center justify-between">
            <h2 class="p4-display text-2xl font-medium">{{ f.privacy }}</h2>
            <button type="button" onclick="document.getElementById('privacy-modal').close()" aria-label="{{ f.close }}" class="text-[color:var(--c-paper-hi)] hover:text-[color:var(--c-acc)] bg-transparent border-none cursor-pointer p-1">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>
        <div class="px-6 md:px-8 py-8 space-y-5 text-[color:var(--c-body)] leading-relaxed text-sm md:text-base">
            {% include "privacy/" ~ lang ~ ".njk" %}
        </div>
    </div>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('privacy-modal');
        if (!dialog) return;
        dialog.addEventListener('click', function (e) {
            if (e.target === dialog) dialog.close();
        });
    })();
</script>
