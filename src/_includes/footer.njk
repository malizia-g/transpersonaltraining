{% set contactHref = '#contact' if page.url == '/' else (('/' | url) ~ '#contact') %}
<footer class="bg-[#0B1B30] text-[#B9C4D2] py-16">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 border-b border-white/10 pb-12 mb-12">
            <!-- About Column -->
            <div>
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-10 h-10 flex items-center justify-center bg-[#D9A756] rounded-full">
                        <img src="{{ '/assets/images/Graphics/logo.svg' | url }}" alt="Logo" class="w-8 h-8" style="display:block;" />
                    </div>
                    <h3 class="p4-display text-white font-semibold text-xl tracking-wide">Transpersonal Training</h3>
                </div>
                <p class="text-sm leading-relaxed text-[#8FA0B3]">
                    Educating therapists for a revolution of consciousness through transpersonal psychotherapy and breathwork.
                </p>
                <p class="text-xs leading-relaxed text-[#7185A0] mt-4">
                    Eastwest Transpersonal Training School
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="p4-kicker text-[#D9A756] mb-5">Training</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ '/training-overview/' | url }}" class="hover:text-[#D9A756] transition-colors">Training Overview</a></li>
                    <li><a href="{{ '/curriculum/' | url }}" class="hover:text-[#D9A756] transition-colors">Curriculum</a></li>
                    <li><a href="{{ '/schedule/' | url }}" class="hover:text-[#D9A756] transition-colors">Intensive Schedule</a></li>
                    <li><a href="{{ '/lectures-schedule/' | url }}" class="hover:text-[#D9A756] transition-colors">Lectures Schedule</a></li>
                    <li><a href="{{ '/teachers/' | url }}" class="hover:text-[#D9A756] transition-colors">Our Teachers</a></li>
                    <li><a href="{{ '/blog/' | url }}" class="hover:text-[#D9A756] transition-colors">Blog</a></li>
                </ul>
            </div>

            <!-- Resources -->
            <div>
                <h4 class="p4-kicker text-[#D9A756] mb-5">Resources</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ '/techniques/' | url }}" class="hover:text-[#D9A756] transition-colors">Techniques</a></li>
                    <li><a href="{{ '/venues/' | url }}" class="hover:text-[#D9A756] transition-colors">Venues</a></li>
                    <li><a href="{{ '/what-is-transpersonal-psychology/' | url }}" class="hover:text-[#D9A756] transition-colors">What is Transpersonal Psychology</a></li>
                    <li><a href="{{ '/become-a-client-model/' | url }}" class="hover:text-[#D9A756] transition-colors">Become a Client Model</a></li>
                    <li><a href="{{ '/resources/' | url }}" class="hover:text-[#D9A756] transition-colors">Recommended Reading</a></li>
                    <li><a href="{{ '/collaborations/' | url }}" class="hover:text-[#D9A756] transition-colors">Collaborations</a></li>
                </ul>
            </div>

            <!-- Contact -->
            <div>
                <h4 class="p4-kicker text-[#D9A756] mb-5">Connect</h4>
                <ul class="space-y-2 text-sm">
                    <li><a href="{{ contactHref }}" class="hover:text-[#D9A756] transition-colors">Contact Us</a></li>
                    <li><a href="mailto:west-office@transpersonal-training.com" class="hover:text-[#D9A756] transition-colors">West office &middot; west-office@transpersonal-training.com</a></li>
                    <li><a href="mailto:east-office@transpersonal-training.com" class="hover:text-[#D9A756] transition-colors">East office &middot; east-office@transpersonal-training.com</a></li>
                    <li><a href="tel:+4917638034517" class="hover:text-[#D9A756] transition-colors">West office &middot; +49 176 38034517</a></li>
                    <li><a href="tel:+37379024199" class="hover:text-[#D9A756] transition-colors">East office &middot; +373 79024199</a></li>
                    <li><a href="https://www.facebook.com/EastwestTranspersonalTrainingSchool/" target="_blank" rel="noopener" class="hover:text-[#D9A756] transition-colors inline-flex items-center gap-1.5"><i data-lucide="facebook" class="w-4 h-4"></i>Facebook</a></li>
                    <li><button type="button" onclick="document.getElementById('privacy-modal').showModal()" class="hover:text-[#D9A756] transition-colors text-left bg-transparent border-none p-0 cursor-pointer font-inherit">Privacy Policy</button></li>
                </ul>
            </div>
        </div>

        <!-- Bottom Bar -->
        <div class="flex flex-col md:flex-row justify-between items-center text-xs text-[#7185A0]">
            <p>&copy; 2026 transpersonal-training.com — Educating therapists for a revolution of consciousness.</p>
            <div class="flex gap-6 mt-4 md:mt-0">
                <button type="button" onclick="document.getElementById('privacy-modal').showModal()" class="hover:text-[#D9A756] bg-transparent border-none p-0 cursor-pointer font-inherit">Privacy</button>
                <a href="{{ '/legal-notice/' | url }}" class="hover:text-[#D9A756]">Legal Notice</a>
            </div>
        </div>
    </div>
</footer>

<!-- Privacy Policy Modal -->
<dialog id="privacy-modal" class="max-w-2xl w-[92vw] p-0 backdrop:bg-[#0B1B30]/70 shadow-2xl">
    <div class="bg-[#FEF9EF] max-h-[85vh] overflow-y-auto">
        <div class="sticky top-0 bg-[#0F2540] text-[#FDFBF5] px-6 py-5 flex items-center justify-between">
            <h2 class="p4-display text-2xl font-medium">Privacy Policy</h2>
            <button type="button" onclick="document.getElementById('privacy-modal').close()" aria-label="Close" class="text-[#FDFBF5] hover:text-[#D9A756] bg-transparent border-none cursor-pointer p-1">
                <i data-lucide="x" class="w-6 h-6"></i>
            </button>
        </div>
        <div class="px-6 md:px-8 py-8 space-y-5 text-neutral-warm-700 leading-relaxed text-sm md:text-base">
            <p>
                This website does not use cookies, analytics, tracking pixels or any similar technology, and it does not
                collect, store or process any personal data through your simple use of these pages. There is nothing to
                consent to and nothing to opt out of — no data is gathered by browsing this site.
            </p>
            <h3 class="text-lg font-semibold text-indigo-deep-900">If you contact us or apply</h3>
            <p>
                The only personal data we ever receive is what you choose to send us directly — for example through the
                application form or by writing to
                <a href="mailto:west-office@transpersonal-training.com" class="text-science-blue-700 hover:text-science-blue-800 underline underline-offset-4">west-office@transpersonal-training.com</a>
                (Western track) or
                <a href="mailto:east-office@transpersonal-training.com" class="text-science-blue-700 hover:text-science-blue-800 underline underline-offset-4">east-office@transpersonal-training.com</a>
                (Eastern track).
                In that case, the following applies in accordance with the EU General Data Protection Regulation
                (Regulation (EU) 2016/679, "GDPR"):
            </p>
            <ul class="list-disc list-inside space-y-2">
                <li><span class="font-medium text-neutral-warm-800">Data controller:</span> Eastwest Transpersonal Training School, reachable at the email addresses above.</li>
                <li><span class="font-medium text-neutral-warm-800">Categories of data processed:</span> the name, email address and any other information you voluntarily include in your message or application.</li>
                <li><span class="font-medium text-neutral-warm-800">Purpose and legal basis:</span> responding to your enquiry and assessing applications, on the basis of your consent (Art. 6(1)(a) GDPR) and, where applicable, to take pre-contractual steps at your request (Art. 6(1)(b) GDPR).</li>
                <li><span class="font-medium text-neutral-warm-800">Retention:</span> your data is kept only for as long as necessary to handle your enquiry or application, and is then deleted.</li>
                <li><span class="font-medium text-neutral-warm-800">Recipients:</span> your data is not sold or shared with third parties, save where strictly necessary to respond to you (e.g. our email provider) or where required by law.</li>
                <li><span class="font-medium text-neutral-warm-800">Your rights:</span> under Articles 15–22 GDPR you may request access to, rectification or erasure of your data, restriction of or objection to its processing, and data portability, and you may lodge a complaint with your national data protection authority at any time. To exercise these rights, simply email us at the address above.</li>
            </ul>
            <p class="text-xs text-neutral-warm-500 pt-2 border-t border-[#E7D6BE]">
                Last updated 2026.
            </p>
        </div>
    </div>
</dialog>
<script>
    (function () {
        var dialog = document.getElementById('privacy-modal');
        if (!dialog) return;
        dialog.addEventListener('click', function (e) {
            if (e.target === dialog) dialog.close();
        });
    })();
</script>
