<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set excerpt = excerpt or description %}
    {% set ogtype = ogtype or ogType or ('article' if page.url != '/blog/' and (page.url | startsWith('/blog/')) else 'website') %}
    <title>{% pageTitle "" %}</title>

    <meta name="description" content="{% pageDescription "" %}">
    <meta name="robots" content="{% metaRobots "" %}">
    <meta name="author" content="{% metaAuthor "" %}">

    {# Syndicated blog posts set sourceUrl to the original article. Canonical then
       points there instead of at our copy — Google's recommended pattern for
       republished content — so the copy doesn't compete with (or get penalized
       against) the original for ranking. #}
    {% if sourceUrl %}
    <link rel="canonical" href="{{ sourceUrl }}">
    {% else %}
    <link rel="canonical" href="{% canonicalURL "" %}">
    {% endif %}

    {% openGraph "" %}
    {% twitterCard "" %}

    {# JSON-LD Structured Data #}
    {% if page.url == "/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Transpersonal Training",
      "url": "https://transpersonal-training.com",
      "description": "Professional transpersonal psychotherapy and breathwork training. EUROTAS-accredited online programme, one international East–West cohort, with in-person intensives in Europe.",
      "email": "office@transpersonal-training.com",
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+49-176-38034517",
          "contactType": "admissions",
          "areaServed": "Western track",
          "availableLanguage": ["English", "German"]
        },
        {
          "@type": "ContactPoint",
          "telephone": "+373-79024199",
          "contactType": "admissions",
          "areaServed": "Eastern track",
          "availableLanguage": ["Russian", "English"]
        }
      ],
      "sameAs": ["https://www.facebook.com/EastwestTranspersonalTrainingSchool/"],
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "Professional Certification",
        "recognizedBy": {
          "@type": "Organization",
          "name": "EUROTAS"
        }
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": "Transpersonal Psychotherapy & Holotropic Breathwork Training",
      "description": "A four-year, EUROTAS-accredited training in Transpersonal Psychotherapy, Counselling and Holotropic Breathwork®, delivered online to one international East–West cohort, with in-person intensives held in Europe.",
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Transpersonal Training",
        "url": "https://transpersonal-training.com"
      },
      "educationalLevel": "Professional",
      "educationalCredentialAwarded": "Certificate as Transpersonal Psychotherapy & Holotropic Breathwork Facilitator (EUROTAS-accredited), with an optional EUROTAS certification track",
      "timeRequired": "P4Y",
      "occupationalCategory": "Transpersonal Psychotherapy & Breathwork Facilitator",
      "teaches": ["Transpersonal Psychology", "Holotropic Breathwork", "Counselling Skills", "Psychotherapy"],
      "availableLanguage": "English",
      "inLanguage": "en",
      "courseMode": ["online", "onsite"],
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Blended",
        "startDate": "2027",
        "endDate": "2030"
      }
    }
    </script>
    {% endif %}
    
    <!-- Page Loader Styles (inline for immediate display) -->
    <style>
        #page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.3s ease-out;
        }
        
        #page-loader.hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid rgba(201, 164, 92, 0.25);
            border-top-color: #C9A45C;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        
        .loader-text {
            color: #334155;
            font-size: 1.125rem;
            font-weight: 500;
            margin-top: 1.5rem;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
    
    <!-- Stylesheets (load first for faster rendering) -->
    <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
        <link rel="icon" type="image/x-icon" href="{{ '/assets/images/Graphics/favicon.ico' | url }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/Graphics/favicon-32x32.png' | url }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/images/Graphics/favicon-16x16.png' | url }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/Graphics/apple-touch-icon.png' | url }}">
    
    <!-- Fonts (preconnect and async load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet"></noscript>
    
    <!-- Lucide Icons (defer loading) -->
    <script src="https://unpkg.com/lucide@0.344.0" defer></script>
</head>
<body class="font-sans text-slate-800 bg-slate-50 antialiased">

    <!-- Page Loader -->
    <div id="page-loader">
        <div class="loader-spinner"></div>
        <div class="loader-text">Loading...</div>
    </div>

    <!-- Navigation -->
    {% include "navigation.njk" %}

    <!-- Main Content -->
    <main>
        {{ content | safe }}
    </main>

    <!-- Footer -->
    {% include "footer.njk" %}

    <!-- Where the forms post to (set in src/_data/forms.js) -->
    <script>window.FORMS_ENDPOINT = {{ forms.endpoint | dump | safe }};</script>

    <!-- Main application script -->
    <script type="module" src="{{ '/scripts/main.js' | url }}"></script>

    {% block scripts %}{% endblock %}
    
    <!-- Remove loader when page is fully loaded -->
    <script>
        window.addEventListener('load', function() {
            const loader = document.getElementById('page-loader');
            if (loader) {
                loader.classList.add('hidden');
                setTimeout(() => loader.remove(), 300);
            }
        });
    </script>
</body>
</html>
