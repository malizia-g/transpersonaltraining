<!DOCTYPE html>
{% set t = i18n[lang] %}
<html lang="{{ lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set excerpt = excerpt or description %}
    {% set ogtype = ogtype or ogType or ('article' if page.url != '/blog/' and (page.url | startsWith('/blog/')) else 'website') %}
    <title>{% pageTitle "" %}</title>

    <meta name="description" content="{% pageDescription "" %}">
    <meta name="robots" content="{% metaRobots "" %}">
    <meta name="author" content="{% metaAuthor "" %}">

    {# Syndicated blog posts set sourceUrl to the original article. Canonical then
       points there instead of at our copy — Google's recommended pattern for
       republished content — so the copy doesn't compete with (or get penalized
       against) the original for ranking. #}
    {% if sourceUrl %}
    <link rel="canonical" href="{{ sourceUrl }}">
    {% else %}
    <link rel="canonical" href="{% canonicalURL "" %}">
    {% endif %}

    {# Language versions of this page. A translation names its English page in
       `translationOf`; an English page is its own key. hreflang has to be
       reciprocal and self-referencing to count, which is why every version
       lists every version, itself included. x-default is English: the
       version for anyone whose language has no page of its own. #}
    {% set altKey = translationOf or page.url %}
    {% set alts = collections.translations[altKey] %}
    {% if alts %}
    {% for code, href in alts %}
    <link rel="alternate" hreflang="{{ code }}" href="{{ seo.url }}{{ href }}">
    {% endfor %}
    <link rel="alternate" hreflang="x-default" href="{{ seo.url }}{{ alts.en }}">
    {% endif %}

    {# First visit in a Russian-language browser: an English page that has a
       Russian version sends the reader there. Once someone picks a language
       with the switcher, that choice wins from then on, in both directions.

       Done here rather than with an Accept-Language rule in .htaccess on
       purpose. Search engines must be able to fetch the English URL and get
       the English page — a server redirect keyed on language risks the
       crawler only ever seeing one version — and Yandex's crawler renders
       pages in a Russian locale, so crawlers are excluded by user agent too.
       It runs in <head>, before anything paints, so there is no flash of the
       English page. #}
    {% if lang == 'en' and alts and alts.ru %}
    <script>
    (function () {
        try {
            if (/bot|crawl|spider|slurp|yandex|lighthouse|headless/i.test(navigator.userAgent)) return;
            var chosen = null;
            try { chosen = localStorage.getItem('lang'); } catch (e) {}
            var wantsRu = chosen ? chosen === 'ru'
                : /^ru\b/i.test((navigator.languages && navigator.languages[0]) || navigator.language || '');
            if (wantsRu) location.replace({{ (alts.ru | url) | dump | safe }} + location.hash);
        } catch (e) {}
    })();
    </script>
    {% endif %}

    {% openGraph "" %}
    <meta property="og:locale" content="{{ t.ogLocale }}">
    {% if alts %}{% for code, href in alts %}{% if code != lang %}
    <meta property="og:locale:alternate" content="{{ i18n[code].ogLocale }}">
    {% endif %}{% endfor %}{% endif %}
    {% twitterCard "" %}

    {# JSON-LD Structured Data #}
    {% set sc = t.schema %}
    {% if page.url == "/" or translationOf == "/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "EducationalOrganization",
      "name": "Transpersonal Training",
      "url": "https://transpersonal-training.com",
      "description": {{ sc.orgDescription | dump | safe }},
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "telephone": "+49-176-38034517",
          "email": "west-office@transpersonal-training.com",
          "contactType": "admissions",
          "areaServed": {{ sc.westTrack | dump | safe }},
          "availableLanguage": ["English", "German"]
        },
        {
          "@type": "ContactPoint",
          "telephone": "+373-79024199",
          "email": "east-office@transpersonal-training.com",
          "contactType": "admissions",
          "areaServed": {{ sc.eastTrack | dump | safe }},
          "availableLanguage": ["Russian", "English"]
        }
      ],
      "sameAs": ["https://www.facebook.com/EastwestTranspersonalTrainingSchool/"],
      "hasCredential": {
        "@type": "EducationalOccupationalCredential",
        "credentialCategory": "Professional Certification",
        "recognizedBy": {
          "@type": "Organization",
          "name": "EUROTAS"
        }
      }
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Course",
      "name": {{ sc.courseName | dump | safe }},
      "description": {{ sc.courseDescription | dump | safe }},
      "provider": {
        "@type": "EducationalOrganization",
        "name": "Transpersonal Training",
        "url": "https://transpersonal-training.com"
      },
      "educationalLevel": "Professional",
      "educationalCredentialAwarded": {{ sc.credential | dump | safe }},
      "timeRequired": "P4Y",
      "occupationalCategory": {{ sc.occupation | dump | safe }},
      "teaches": {{ sc.teaches | dump | safe }},
      {#- Lectures are in English (with automatic Russian translation); the
          Eastern track's intensives are held in Russian. #}
      "availableLanguage": ["English", "Russian"],
      "inLanguage": {{ lang | dump | safe }},
      "courseMode": ["online", "onsite"],
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Blended",
        "startDate": "2027",
        "endDate": "2030"
      }
    }
    </script>
    {% endif %}

    {# One Person per teacher, each anchored to the fragment its old bio URL now
       redirects to. This is the load-bearing piece of the migration: 32 separate
       bio pages were collapsed into this single one, and those pages were 64% of
       the site's organic clicks. The @id tying each person to /teachers/#<id> is
       what tells Google this page represents 32 distinct people rather than one
       document that happens to mention them. #}
    {% if page.url == "/teachers/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
      {%- for teacher in teachers.all %}
        {
          "@type": "Person",
          "@id": "https://transpersonal-training.com/teachers/#{{ teacher.id }}",
          "url": "https://transpersonal-training.com/teachers/#{{ teacher.id }}",
          "name": {{ teacher.name | dump | safe }},
          {%- if teacher.role %}
          "jobTitle": {{ teacher.role | dump | safe }},
          {%- endif %}
          {%- if teacher.credentials %}
          "description": {{ teacher.credentials | dump | safe }},
          {%- endif %}
          {%- if teacher.image %}
          "image": "https://transpersonal-training.com{{ teacher.image }}",
          {%- endif %}
          {%- if teacher.location %}
          "homeLocation": { "@type": "Place", "name": {{ teacher.location | dump | safe }} },
          {%- endif %}
          {%- if teacher.website %}
          "sameAs": [{{ teacher.website | dump | safe }}],
          {%- endif %}
          "affiliation": {
            "@type": "EducationalOrganization",
            "name": "Transpersonal Training",
            "url": "https://transpersonal-training.com"
          }
        }{% if not loop.last %},{% endif %}
      {%- endfor %}
      ]
    }
    </script>
    {% endif %}

    {# Upcoming intensives only, and only the ones this school actually runs.

       Three exclusions, each because publishing the row as-is would state
       something untrue:

       - Past events. Google's event results are for things you can still
         attend, and the sheet holds 29 dates that have been and gone.
       - Dates the isoDateRange filter can't read. Skipped rather than guessed.
       - Events we don't organise. The sheet lists the EUROTAS conference so
         students know it exists, but EUROTAS runs it — marking it up with
         ourselves as `organizer` and our own /schedule/ as its `url` would
         claim someone else's event as ours. `type1` is the only field that
         separates them, so Conference stands in for "not ours"; if the school
         ever runs its own conference, this needs a real column in the sheet
         instead. #}
    {% if page.url == "/schedule/" %}
    {%- set upcoming = [] %}
    {%- for event in scheduleEvents %}
      {%- set d = event.date | isoDateRange %}
      {%- if d and d.end >= todayISO and event.type1 != 'Conference' %}{% set _ = upcoming.push({ e: event, d: d }) %}{% endif %}
    {%- endfor %}
    {%- if upcoming.length %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
      {%- for item in upcoming %}
        {
          "@type": "Event",
          "name": {{ item.e.title | dump | safe }},
          "startDate": "{{ item.d.start }}",
          "endDate": "{{ item.d.end }}",
          "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
          "eventStatus": "https://schema.org/EventScheduled",
          {%- if item.e.description %}
          "description": {{ item.e.description | dump | safe }},
          {%- endif %}
          {%- if item.e.location %}
          "location": { "@type": "Place", "name": {{ item.e.location | dump | safe }},
            "address": { "@type": "PostalAddress", "addressCountry": {{ item.e.location | dump | safe }} } },
          {%- endif %}
          {#- The sheet writes "-" for a facilitator not yet assigned, which is
              five of the nine upcoming rows. Emitting it produced a Person
              literally named "-". #}
          {%- if item.e.facilitator and item.e.facilitator != '-' %}
          "performer": { "@type": "Person", "name": {{ item.e.facilitator | dump | safe }} },
          {%- endif %}
          "url": "https://transpersonal-training.com/schedule/",
          "organizer": {
            "@type": "EducationalOrganization",
            "name": "Transpersonal Training",
            "url": "https://transpersonal-training.com"
          }
        }{% if not loop.last %},{% endif %}
      {%- endfor %}
      ]
    }
    </script>
    {%- endif %}
    {% endif %}

    {# Blog posts. The index page is excluded — it is a listing, not an article. #}
    {% if page.url.startsWith("/blog/") and page.url != "/blog/" %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ title | dump | safe }},
      "url": "https://transpersonal-training.com{{ page.url }}",
      "mainEntityOfPage": "https://transpersonal-training.com{{ page.url }}",
      {%- if description %}
      "description": {{ description | dump | safe }},
      {%- endif %}
      {%- if page.date %}
      "datePublished": "{{ page.date | date('yyyy-MM-dd') }}",
      {%- endif %}
      {%- if author %}
      "author": { "@type": "Person", "name": {{ author | dump | safe }} },
      {%- endif %}
      "publisher": {
        "@type": "EducationalOrganization",
        "name": "Transpersonal Training",
        "url": "https://transpersonal-training.com"
      }
    }
    </script>
    {% endif %}

    {# Breadcrumbs. The site is flat, so most pages are simply Home > Page; blog
       posts get the extra Blog level. Worth emitting even for one level: Google
       renders it in place of the raw URL in results. #}
    {% set homeUrl = '/' | localeUrl(lang) %}
    {% if page.url != homeUrl %}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": {{ t.home | dump | safe }},
          "item": "https://transpersonal-training.com{{ homeUrl }}"
        }{% if page.url.startsWith("/blog/") and page.url != "/blog/" %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://transpersonal-training.com/blog/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": {{ title | dump | safe }}
        }{% else %},
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ title | dump | safe }}
        }{% endif %}
      ]
    }
    </script>
    {% endif %}

    <!-- Page Loader Styles (inline for immediate display) -->
    <style>
        #page-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.3s ease-out;
        }
        
        #page-loader.hidden {
            opacity: 0;
            pointer-events: none;
        }
        
        .loader-spinner {
            width: 50px;
            height: 50px;
            border: 4px solid var(--c-acc-25, rgba(201, 164, 92, 0.25));
            border-top-color: var(--c-acc, #D9A756);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        
        .loader-text {
            color: var(--c-body, #334155);
            font-size: 1.125rem;
            font-weight: 500;
            margin-top: 1.5rem;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
    
    <!-- Stylesheets (load first for faster rendering) -->
    <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
        <link rel="icon" type="image/x-icon" href="{{ '/assets/images/Graphics/favicon.ico' | url }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/Graphics/favicon-32x32.png' | url }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/images/Graphics/favicon-16x16.png' | url }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/Graphics/apple-touch-icon.png' | url }}">
    
    {# Fonts are self-hosted and declared in main.css — see the note at the top of
       src/styles/main.css for why. No preconnect is needed any more: they come
       from this origin, already connected. These two carry the visible text on
       first paint, so they are preloaded; the rest load as the page needs them. #}
    <link rel="preload" href="{{ '/assets/fonts/Inter-400-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ '/assets/fonts/CormorantGaramond-600-latin.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    {% if lang == 'ru' %}
    <link rel="preload" href="{{ '/assets/fonts/Inter-cyrillic.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ '/assets/fonts/CormorantGaramond-cyrillic.woff2' | url }}" as="font" type="font/woff2" crossorigin>
    {% endif %}

    {# Lucide, self-hosted at the version we were already pinning. Same reasoning
       as the fonts: one fewer third party watching visitors arrive, and one
       fewer origin to reach before the icons appear. #}
    <script src="{{ '/scripts/vendor/lucide-0.344.0.js' | url }}" defer></script>
</head>
<body class="font-sans text-[color:var(--c-heading)] bg-[color:var(--c-paper-hi)] antialiased">

    <!-- Page Loader -->
    <div id="page-loader">
        <div class="loader-spinner"></div>
        <div class="loader-text">{{ t.loading }}</div>
    </div>

    <!-- Navigation -->
    {% include "navigation.njk" %}

    <!-- Main Content -->
    <main>
        {{ content | safe }}
    </main>

    <!-- Footer -->
    {% include "footer.njk" %}

    <!-- Where the forms post to (set in src/_data/forms.js) -->
    <script>window.FORMS_ENDPOINT = {{ forms.endpoint | dump | safe }};</script>

    <!-- Main application script -->
    <script type="module" src="{{ '/scripts/main.js' | url }}"></script>

    {% block scripts %}{% endblock %}
    
    <!-- Remove loader when page is fully loaded -->
    <script>
        window.addEventListener('load', function() {
            const loader = document.getElementById('page-loader');
            if (loader) {
                loader.classList.add('hidden');
                setTimeout(() => loader.remove(), 300);
            }
        });
    </script>
</body>
</html>
