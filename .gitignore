# Build output
_site/
dist/

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Large binary archives
*.zip

# IDE
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.local

# Data cache files (generated during build)
src/_data/*.cache.json

# Scratch copies of the Apps Script files, kept at the root only to make them
# easy to copy-paste into the Google editor. The versioned originals live in
# docs/spreadsheet-automation/.
APPS-SCRIPT-*.js

# Claude Code local/runtime state (not shared config)
.claude/settings.local.json
.claude/scheduled_tasks.lock
